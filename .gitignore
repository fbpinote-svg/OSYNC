# Only our own scripts, menu source, settings and docs go to git.
# Never: game files, launcher programs (third-party), the built menu, data made on each master, logs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/OSYNC.bat
!/Clear-Logins.bat
!/EASY-INSTALL.bat
# forwarder for client images made before the new layout (old task runs _system\Install-All.ps1)
!/_system/
/_system/*
!/_system/Install-All.ps1
!/Settings/
!/System/
!/Menu/

# made on each master
/System/Data/
/System/Backup/
# OSYNC-Setup.exe files made by OSYNC.bat > 7 > 19 (big, rebuilt any time)
/System/Dist/

# Menu (GCafe): built program, build output and data made on each master
/Menu/app/
/Menu/_build/
/Menu/source/node_modules/
/Menu/source/out/
/Menu/source/.next/
/Menu/data/games.json
/Menu/data/posters/

*.log
*.new
Thumbs.db
desktop.ini
